<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Šachový pomocník</title>
<link rel="stylesheet" href="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.css">
<style>
  body { font-family: system-ui, sans-serif; margin:0; padding:12px;
         background:#1e1e1e; color:#eee; text-align:center; }
  #board { width: min(92vw, 420px); margin: 0 auto; }
  #result { font-size:17px; margin:12px 0; min-height:3.5em; line-height:1.4; }
  button { font-size:16px; padding:12px 18px; margin:4px; border-radius:10px;
           border:0; background:#4a90d9; color:#fff; }
  button.sec { background:#555; }
</style>
</head>
<body>
  <div id="board"></div>
  <p id="result">Táhni figurkou, pak klikni „Nejlepší tah“.</p>
  <button onclick="analyze()">Nejlepší tah</button>
  <button class="sec" onclick="undo()">Zpět</button>
  <button class="sec" onclick="reset()">Reset</button>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chess.js@0.10.3/chess.min.js"></script>
<script>
const game = new Chess();

const board = Chessboard('board', {
  draggable: true,
  position: 'start',
  pieceTheme: 'https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/img/chesspieces/wikipedia/{piece}.png',
  onDrop: (from, to) => {
    const m = game.move({ from, to, promotion: 'q' });
    if (!m) return 'snapback';
  },
  onSnapEnd: () => board.position(game.fen())
});

async function analyze() {
  const out = document.getElementById('result');
  out.textContent = 'Počítám…';
  const fen = game.fen();
  try {
    const r = await fetch('https://lichess.org/api/cloud-eval?multiPv=1&fen=' + encodeURIComponent(fen));
    if (r.status === 404) {
      out.textContent = 'Tuto pozici Lichess v cloudu nemá. Zkus jinou.';
      return;
    }
    if (!r.ok) { out.textContent = 'Chyba API (' + r.status + ').'; return; }

    const d = await r.json();
    const pv = d.pvs && d.pvs[0];
    if (!pv) { out.textContent = 'Žádný tah.'; return; }

    const uci = pv.moves.split(' ')[0];
    const tmp = new Chess(fen);
    const m = tmp.move({ from: uci.slice(0,2), to: uci.slice(2,4), promotion: uci[4] || 'q' });
    const san = m ? m.san : uci;
    const ev = typeof pv.mate !== 'undefined'
      ? 'mat ' + pv.mate
      : ((pv.cp > 0 ? '+' : '') + (pv.cp / 100).toFixed(2));

    out.textContent = `Nejlepší: ${san}   (${ev}, hloubka ${d.depth})`;
  } catch (e) {
    out.textContent = 'Chyba: ' + e.message;
  }
}

function reset() { game.reset(); board.start(); document.getElementById('result').textContent = '—'; }
function undo()  { game.undo(); board.position(game.fen()); }
</script>
</body>
</html>